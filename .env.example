# Copy this file to .env and fill in your values.
# .env is gitignored and loaded automatically at startup.

# Telegram bot token from @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# Optional: new chats must send this passphrase before the bot responds.
# Leave blank to auto-generate a funny one at startup (printed to the log).
BOT_PASSPHRASE=